@pytest.fixture
def fake_ros(monkeypatch):
    from action_msgs.msg import GoalStatus

    wrapped = MagicMock()
    wrapped.status = GoalStatus.STATUS_SUCCEEDED
    wrapped.result.success = True
    wrapped.result.error_code = 0
    wrapped.result.num_retries = 0
    wrapped.result.message = "ok"

    result_future = MagicMock()
    result_future.done.return_value = True
    result_future.result.return_value = wrapped

    goal_handle = MagicMock()
    goal_handle.accepted = True
    goal_handle.get